<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LifeHub" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/brand_deep</item>
        <item name="android:statusBarColor">@color/brand_deep</item>
        <item name="android:navigationBarColor">@color/brand_deep</item>
    </style>
    <style name="Theme.LifeHub.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_deep</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.LifeHub</item>
    </style>
</resources>
